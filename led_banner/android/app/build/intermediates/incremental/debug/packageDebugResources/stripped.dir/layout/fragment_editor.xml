<?xml version="1.0" encoding="utf-8"?>
<!-- Вкладка «Редактор»: пишет текст, показывает живое превью и очередь -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">

        <!-- Превью ленты -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CardBox" android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/lbl_preview" android:textColor="@color/muted" android:textSize="13sp"/>
                <com.newyear.banner.ui.BannerPreviewView
                    android:id="@+id/preview"
                    android:layout_width="match_parent" android:layout_height="96dp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Ввод текста -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CardBox" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">

                <EditText android:id="@+id/etText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="@string/hint_text" android:maxLength="200"
                    android:inputType="textCapSentences|textMultiLine" android:minLines="2"
                    android:textColorHint="#5A6490"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="6dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/lbl_effect" android:layout_marginEnd="6dp"/>
                    <Spinner android:id="@+id/spEffect" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/lbl_speed" android:layout_marginStart="10dp" android:layout_marginEnd="6dp"/>
                    <Spinner android:id="@+id/spSpeed" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShowNow" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="@string/btn_show_now"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddQueue" style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp"
                        android:text="@string/btn_add_queue"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Быстрые новогодние фразы -->
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:id="@+id/quickRow"/>
        </HorizontalScrollView>

        <!-- Очередь -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CardBox" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/lbl_queue" android:textStyle="bold"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvQueue" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendPl" android:layout_width="0dp" android:layout_weight="2"
                        android:layout_height="wrap_content" android:text="@string/btn_send_playlist"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearPl" style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="@string/btn_clear"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
