<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="6dp" android:gravity="center_vertical">

    <TextView android:id="@+id/tvNum" android:layout_width="24dp" android:layout_height="wrap_content"
        android:textColor="@color/accent" android:textStyle="bold"/>
    <TextView android:id="@+id/tvText" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="15sp"/>
    <ImageButton android:id="@+id/btnUp" android:layout_width="36dp" android:layout_height="36dp"
        android:src="@android:drawable/arrow_up_float" android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="up"/>
    <ImageButton android:id="@+id/btnDown" android:layout_width="36dp" android:layout_height="36dp"
        android:src="@android:drawable/arrow_down_float" android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="down"/>
    <ImageButton android:id="@+id/btnDel" android:layout_width="36dp" android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel" android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="delete"/>
</LinearLayout>
